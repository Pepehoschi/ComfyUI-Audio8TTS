{
  "1": {"class_type": "Audio8ModelLoader", "inputs": {"ckpt_name": "audio8/Audio8-TTS-Realistic-0.6b.safetensors", "dtype": "auto"}},
  "2": {"class_type": "Audio8LoadVoice", "inputs": {"voice": "voice.safetensors"}},
  "3": {
    "class_type": "Audio8TTS",
    "inputs": {
